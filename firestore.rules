rules_version = '2';

// Security rules for the Daisenko Hero Service technician app.
// Auth model: each technician signs in with Firebase Auth (Email/Password,
// email = "<phone>@daisenkohero.local"). The technician's Firestore doc is
// linked to their Auth account via the `authUid` field, which is set ONLY by
// admin tooling (scripts/add-technician.js, scripts/migrate-auth.js) — never by
// the app. Anyone holding the app's public config can create a Firebase Auth
// account, so "signed in" alone must never grant access to anyone's data.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Office staff. The `role` custom claim is set only by the Admin SDK
    // (scripts/set-role.js), so a self-created account can never carry it.
    function isAdmin() {
      return isSignedIn() && request.auth.token.get('role', '') == 'admin';
    }

    // True if the signed-in user owns the technician doc `techId`
    // (i.e. that doc's authUid matches their Firebase Auth uid).
    function ownsTechnician(techId) {
      return isSignedIn()
        && techId is string
        && exists(/databases/$(database)/documents/technicians/$(techId))
        && get(/databases/$(database)/documents/technicians/$(techId)).data.authUid
             == request.auth.uid;
    }

    function contactWindowOpen(job) {
      return job.get('startTime', null) is timestamp
        && request.time >= job.startTime - duration.value(12, 'h')
        && !(job.get('status', '') in ['cancelled', 'expired'])
        && (
          !(job.get('status', '') in ['completed', 'closed'])
          || (job.get('finishedAt', null) is timestamp
              && request.time < job.finishedAt + duration.value(24, 'h'))
        );
    }

    match /technicians/{techId} {
      // A technician may read only their own profile. The login query
      // `where('authUid', '==', uid)` satisfies this rule.
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.authUid == request.auth.uid);

      // A technician may update their own doc, but not the fields that link it
      // to an account or identify it.
      allow update: if isAdmin() || (isSignedIn()
        && resource.data.authUid == request.auth.uid
        && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['authUid', 'phone']));

      // Admins manage technician profiles. Login accounts (and the authUid
      // link) are still created by scripts/add-technician.js.
      allow create, delete: if isAdmin();
    }

    match /jobs/{jobId} {
      // A technician may read and update only their own jobs.
      // Admins create, assign, edit and remove any job.
      allow read: if isAdmin() || ownsTechnician(resource.data.technicianId);
      allow update: if isAdmin() || (ownsTechnician(resource.data.technicianId)
        && ownsTechnician(request.resource.data.technicianId));
      allow create, delete: if isAdmin();

      // Customer contact (phone). A technician may read it only around their
      // own job: from 12 hours before the start time until 24 hours after the
      // job is finished, and never for cancelled/expired jobs. This keeps
      // customers from being contacted off-platform later. Admins: full access.
      match /private/{docId} {
        allow read: if isAdmin() || (
          ownsTechnician(get(/databases/$(database)/documents/jobs/$(jobId)).data.technicianId)
          && contactWindowOpen(get(/databases/$(database)/documents/jobs/$(jobId)).data)
        );
        allow write: if isAdmin();
      }
    }

    // Self sign-up for new technicians (Google). The applicant's own Auth uid is
    // the doc id. Applicants can only create/edit their own application while
    // it is pending (or resubmit after a rejection) and can never approve it;
    // an admin approves by creating the technicians doc with this uid as
    // authUid, so "signed in with Google" alone still grants no technician data.
    match /applications/{uid} {
      function ownApplicationFields() {
        return request.resource.data.status == 'pending'
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.phone is string
          && request.resource.data.phone.size() >= 9
          && request.resource.data.agreedToTerms == true;
      }
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow create: if isSignedIn() && request.auth.uid == uid
        && ownApplicationFields()
        && !request.resource.data.keys().hasAny(['reviewedBy', 'reviewedAt', 'technicianId', 'rejectReason']);
      allow update: if isAdmin() || (
        isSignedIn() && request.auth.uid == uid
        && resource.data.status in ['pending', 'rejected']
        && ownApplicationFields()
        && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['reviewedBy', 'reviewedAt', 'technicianId', 'rejectReason'])
      );
      allow delete: if isAdmin();
    }

    match /activity_events/{eventId} {
      // Append-only usage log: a technician may only add and read events about
      // themselves; admins read all (reporting). Nobody edits or deletes.
      // Admins log their own dispatcher logins under their uid.
      allow create: if ownsTechnician(request.resource.data.technicianId)
        || (isAdmin() && request.resource.data.technicianId == request.auth.uid);
      allow read: if isAdmin() || ownsTechnician(resource.data.technicianId);
      allow update, delete: if false;
    }

    // Everything else (including the legacy `users` collection) is denied.
  }
}
