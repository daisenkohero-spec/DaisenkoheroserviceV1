rules_version = '2';

// Security rules for Daisenko Hero Service.
//
// Two roles:
//  - Technician: signs in with Firebase Auth (email = "<phone>@daisenkohero.local").
//    Scoped to their own technician doc, jobs, and events.
//  - Admin (dispatcher): has a doc at admins/{their-auth-uid}. Can manage jobs and
//    read all technicians/jobs/events for the dispatcher + reporting.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // True if the signed-in user is an admin (has an admins/{uid} doc).
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // True if the signed-in user owns the technician doc `techId`.
    function ownsTechnician(techId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/technicians/$(techId)).data.authUid
             == request.auth.uid;
    }

    // Admin registry. Created/removed only via the Admin SDK (add-admin.js),
    // never from a client. A user may read their own admin doc (to learn their
    // role at login); admins may read the whole registry.
    match /admins/{uid} {
      allow read: if isSignedIn() && (uid == request.auth.uid || isAdmin());
      allow create, update, delete: if false;
    }

    match /technicians/{techId} {
      // Technicians and admins may read technician profiles.
      allow read: if isSignedIn();

      // A technician may update only their own doc (with first-login authUid
      // claim), OR an admin may update any technician.
      allow update: if isAdmin() || (isSignedIn() && (
        resource.data.authUid == request.auth.uid ||
        (!("authUid" in resource.data)
          && request.resource.data.authUid == request.auth.uid)
      ));

      // Only admins create/delete technicians (also done via Admin SDK script).
      allow create, delete: if isAdmin();
    }

    match /jobs/{jobId} {
      // Technicians read/update only their own jobs; admins see and manage all.
      allow read: if isAdmin() || ownsTechnician(resource.data.technicianId);
      allow update: if isAdmin() || (
        ownsTechnician(resource.data.technicianId)
        && ownsTechnician(request.resource.data.technicianId)
      );
      // Admins create and delete jobs (the dispatcher).
      allow create, delete: if isAdmin();
    }

    match /activity_events/{eventId} {
      // Append-only usage log: technicians add events about themselves; admins
      // may also add. Reads: own events, or admins (for reporting). Never edited.
      allow create: if isAdmin() || ownsTechnician(request.resource.data.technicianId);
      allow read: if isAdmin() || ownsTechnician(resource.data.technicianId);
      allow update, delete: if false;
    }

    // Legacy/unused collection — deny by default.
    match /users/{docId} {
      allow read, write: if false;
    }
  }
}
