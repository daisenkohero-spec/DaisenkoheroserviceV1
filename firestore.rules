rules_version = '2';

// Security rules for the Daisenko Hero Service technician app.
// Auth model: each technician signs in with Firebase Auth (Email/Password,
// email = "<phone>@daisenkohero.local"). The technician's Firestore doc is
// linked to their Auth account via the `authUid` field, which is set ONLY by
// admin tooling (scripts/add-technician.js, scripts/migrate-auth.js) — never by
// the app. Anyone holding the app's public config can create a Firebase Auth
// account, so "signed in" alone must never grant access to anyone's data.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // True if the signed-in user owns the technician doc `techId`
    // (i.e. that doc's authUid matches their Firebase Auth uid).
    function ownsTechnician(techId) {
      return isSignedIn()
        && techId is string
        && exists(/databases/$(database)/documents/technicians/$(techId))
        && get(/databases/$(database)/documents/technicians/$(techId)).data.authUid
             == request.auth.uid;
    }

    match /technicians/{techId} {
      // A technician may read only their own profile. The login query
      // `where('authUid', '==', uid)` satisfies this rule.
      allow read: if isSignedIn() && resource.data.authUid == request.auth.uid;

      // A technician may update their own doc, but not the fields that link it
      // to an account or identify it.
      allow update: if isSignedIn()
        && resource.data.authUid == request.auth.uid
        && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['authUid', 'phone']);

      // Creating/deleting technicians is an admin action (Admin SDK).
      allow create, delete: if false;
    }

    match /jobs/{jobId} {
      // A technician may read and update only their own jobs.
      allow read: if ownsTechnician(resource.data.technicianId);
      allow update: if ownsTechnician(resource.data.technicianId)
        && ownsTechnician(request.resource.data.technicianId);
      // Jobs are created/removed by admin (Admin SDK), not the app.
      allow create, delete: if false;
    }

    match /activity_events/{eventId} {
      // Append-only usage log: a technician may only add and read events about
      // themselves, and events can never be edited or deleted.
      allow create: if ownsTechnician(request.resource.data.technicianId);
      allow read: if ownsTechnician(resource.data.technicianId);
      allow update, delete: if false;
    }

    // Everything else (including the legacy `users` collection) is denied.
  }
}
